{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@infra/*": ["src/infrastructure/*"],
      "@config/*": ["src/config/*"],
      "@bot-core/*": ["apps/bot-core/src/*"],
      "@bybit/*": ["src/services/bybit/*"]
    }
  },
  "include": ["src/**/*", "apps/**/*"],
  "exclude": ["node_modules", "dist"]
}
